# Flotteo - Racine du projet
Options -Indexes -MultiViews +FollowSymLinks

# Protection des fichiers et répertoires sensibles
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

<FilesMatch "\.(sql|lock|md|log|json|yml|yaml|sh|dist)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Redirection vers public/ si l'accès est fait sur la racine du dossier projet
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Si la cible est déjà index.php ou public, arrêt immédiat
    RewriteRule ^index\.php$ - [L]
    RewriteRule ^public/index\.php$ - [L]
    RewriteCond %{ENV:REDIRECT_STATUS} 200 [OR]
    RewriteCond %{REQUEST_URI} (^|/)public/ [NC,OR]
    RewriteCond %{REQUEST_FILENAME} /public/ [NC]
    RewriteRule ^ - [L]

    # Ressources statiques
    RewriteRule ^(?:assets|uploads)/ public/$0 [L]
    RewriteRule ^(?:app\.json|favicon\.svg|robots\.txt)$ public/$0 [L]

    # Interdire l'accès direct aux dossiers système hors public
    RewriteRule ^(?:config|core|controllers|models|services|views|sql|scripts|storage|docs|bin)(?:/|$) - [F,L]

    # Fichiers et dossiers réels
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Rediriger toutes les routes applicatives directement vers public/index.php
    RewriteRule ^ public/index.php [QSA,L]
</IfModule>

